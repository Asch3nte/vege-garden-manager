  "glossaireNotionCommencerTitre": "Par où commencer ?",
  "@glossaireNotionCommencerTitre": { "description": "Notion d'accueil du glossaire (seed Lot 2)." },
  "glossaireNotionCommencerDef": "Bienvenue dans le lexique du jardinier ! Parcourez les chapitres à votre rythme : chaque terme de l'app y a sa page, avec des conseils pratiques. Pour débuter, découvrez ce qu'est une [[notion.famille-botanique|famille botanique]], pourquoi pratiquer la [[notion.rotation-cultures|rotation des cultures]], et comment marier vos plantes grâce au [[notion.compagnonnage|compagnonnage]].",
  "@glossaireNotionCommencerDef": { "description": "Définition (liens wiki)." },
  "glossaireNotionCommencerAstuce": "Partout dans l'app, les termes colorés sont cliquables : ils mènent à leur page du lexique.",
  "@glossaireNotionCommencerAstuce": { "description": "Astuce 💡." },
  "glossaireNotionCommencerConseil1": "Utilisez la recherche en haut du lexique : elle fouille les titres et les définitions, accents ou pas.",
  "@glossaireNotionCommencerConseil1": { "description": "Conseil d'utilisation." },
  "glossaireProvenanceTitre": "Provenance",
  "@glossaireProvenanceTitre": { "description": "Étiquette du bloc provenance d'une page mécanisme (ADR-0017 Lot 4)." },
  "glossaireProvenanceCalculee": "Calculé par le moteur : l'app sait déduire ce mécanisme des caractéristiques des plantes (règles de dérivation), en plus des paires documentées par la communauté permaculture.",
  "@glossaireProvenanceCalculee": { "description": "Provenance d'un mécanisme dérivable (inventaire du moteur)." },
  "glossaireProvenanceDocumentee": "Documenté par la communauté : ce mécanisme provient uniquement des associations consignées dans les fiches par la communauté permaculture, reprises telles quelles — l'app ne le déduit pas elle-même.",
  "@glossaireProvenanceDocumentee": { "description": "Provenance d'un mécanisme non dérivable (curaté uniquement)." },

  "glossaireNotionCategoriePlanteTitre": "Catégories de plantes",
  "@glossaireNotionCategoriePlanteTitre": { "description": "Page glossaire CategoriePlante (Lot 4)." },
  "glossaireNotionCategoriePlanteDef": "Chaque fiche du Catalogue est rangée dans une catégorie principale : légume, aromatique, fruit… La catégorie décrit le rôle principal de la plante au potager ; ses rôles secondaires (répulsive, mellifère…) sont portés par les [[notion.usage-plante|usages]].",
  "@glossaireNotionCategoriePlanteDef": { "description": "Définition." },
  "glossaireNotionCategoriePlanteAstuce": "Le Catalogue se filtre par catégorie d'un geste, via les pastilles en haut de l'écran.",
  "@glossaireNotionCategoriePlanteAstuce": { "description": "Astuce 💡." },
  "glossaireNotionSousTypeLegumeTitre": "Sous-types de légumes",
  "@glossaireNotionSousTypeLegumeTitre": { "description": "Page glossaire SousTypeLegume." },
  "glossaireNotionSousTypeLegumeDef": "Les légumes se distinguent par l'organe que l'on récolte : fruit, feuille, racine… Ce sous-type compte pour la [[notion.rotation-cultures|rotation]] : les légumes d'un même organe puisent souvent les mêmes nutriments et partagent des sensibilités.",
  "@glossaireNotionSousTypeLegumeDef": { "description": "Définition." },
  "glossaireValLegumeFruit": "Légume-fruit",
