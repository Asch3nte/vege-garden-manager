  "glossaireValLegumeTigeDesc": "asperge, céleri branche, rhubarbe… on récolte la tige.",
  "@glossaireValLegumeTigeDesc": { "description": "Descriptif de la valeur." },
  "glossaireValLegumeFleur": "Légume-fleur",
  "@glossaireValLegumeFleur": { "description": "Valeur SousTypeLegume." },
  "glossaireValLegumeFleurDesc": "chou-fleur, brocoli, artichaut… on récolte l'inflorescence.",
  "@glossaireValLegumeFleurDesc": { "description": "Descriptif de la valeur." },
  "glossaireValLegumeTubercule": "Légume-tubercule",
  "@glossaireValLegumeTubercule": { "description": "Valeur SousTypeLegume." },
  "glossaireValLegumeTuberculeDesc": "pomme de terre, topinambour… on récolte le tubercule.",
  "@glossaireValLegumeTuberculeDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionUsagePlanteTitre": "Usages d'une plante",
  "@glossaireNotionUsagePlanteTitre": { "description": "Page glossaire UsagePlante." },
  "glossaireNotionUsagePlanteDef": "En plus de sa catégorie, une plante peut jouer plusieurs rôles au jardin. Ces usages alimentent le moteur d'associations : c'est par eux que l'app sait qu'une plante attire les pollinisateurs, éloigne des ravageurs ou fixe l'azote — voir [[notion.calcul-associations|comment l'app calcule les associations]].",
  "@glossaireNotionUsagePlanteDef": { "description": "Définition." },
  "glossaireValUsageAlimentaire": "Alimentaire",
  "@glossaireValUsageAlimentaire": { "description": "Valeur UsagePlante." },
  "glossaireValUsageAlimentaireDesc": "cultivée pour être mangée.",
  "@glossaireValUsageAlimentaireDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageCondimentaire": "Condimentaire",
  "@glossaireValUsageCondimentaire": { "description": "Valeur UsagePlante." },
  "glossaireValUsageCondimentaireDesc": "aromates et condiments pour la cuisine.",
  "@glossaireValUsageCondimentaireDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageMedicinale": "Médicinale",
  "@glossaireValUsageMedicinale": { "description": "Valeur UsagePlante." },
  "glossaireValUsageMedicinaleDesc": "usage traditionnel en tisanes et remèdes.",
  "@glossaireValUsageMedicinaleDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageCompagnonnage": "Compagne",
  "@glossaireValUsageCompagnonnage": { "description": "Valeur UsagePlante." },
  "glossaireValUsageCompagnonnageDesc": "cultivée d'abord pour les services rendus à ses voisines.",
  "@glossaireValUsageCompagnonnageDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageRepulsif": "Répulsive",
  "@glossaireValUsageRepulsif": { "description": "Valeur UsagePlante." },
  "glossaireValUsageRepulsifDesc": "son odeur éloigne certains ravageurs ([[notion.meca-repulsion-ravageur|répulsion]]).",
  "@glossaireValUsageRepulsifDesc": { "description": "Descriptif de la valeur (lien wiki)." },
  "glossaireValUsageMellifere": "Mellifère",
  "@glossaireValUsageMellifere": { "description": "Valeur UsagePlante." },
  "glossaireValUsageMellifereDesc": "son nectar nourrit abeilles et butineurs.",
  "@glossaireValUsageMellifereDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsagePollinisateur": "Attire les pollinisateurs",
  "@glossaireValUsagePollinisateur": { "description": "Valeur UsagePlante." },
  "glossaireValUsagePollinisateurDesc": "favorise la [[notion.meca-attraction-pollinisateurs|pollinisation]] des voisines.",
  "@glossaireValUsagePollinisateurDesc": { "description": "Descriptif de la valeur (lien wiki)." },
  "glossaireValUsageAttireAuxiliaires": "Attire les auxiliaires",
  "@glossaireValUsageAttireAuxiliaires": { "description": "Valeur UsagePlante." },
  "glossaireValUsageAttireAuxiliairesDesc": "héberge les insectes prédateurs des ravageurs (coccinelles, syrphes…) — différent des pollinisateurs.",
  "@glossaireValUsageAttireAuxiliairesDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageEngraisVert": "Engrais vert",
  "@glossaireValUsageEngraisVert": { "description": "Valeur UsagePlante." },
  "glossaireValUsageEngraisVertDesc": "cultivée pour nourrir et structurer le sol.",
  "@glossaireValUsageEngraisVertDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageCouvreSol": "Couvre-sol",
  "@glossaireValUsageCouvreSol": { "description": "Valeur UsagePlante." },
  "glossaireValUsageCouvreSolDesc": "couvre la terre, limite l'évaporation et les indésirables.",
  "@glossaireValUsageCouvreSolDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageBriseVent": "Brise-vent",
  "@glossaireValUsageBriseVent": { "description": "Valeur UsagePlante." },
  "glossaireValUsageBriseVentDesc": "protège les cultures voisines du vent.",
  "@glossaireValUsageBriseVentDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageTuteurVivant": "Tuteur vivant",
  "@glossaireValUsageTuteurVivant": { "description": "Valeur UsagePlante." },
  "glossaireValUsageTuteurVivantDesc": "sa tige sert de support aux grimpantes (le maïs de la milpa).",
  "@glossaireValUsageTuteurVivantDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageOrnementale": "Ornementale",
  "@glossaireValUsageOrnementale": { "description": "Valeur UsagePlante." },
  "glossaireValUsageOrnementaleDesc": "cultivée pour sa beauté.",
  "@glossaireValUsageOrnementaleDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUsageFourrage": "Fourragère",
  "@glossaireValUsageFourrage": { "description": "Valeur UsagePlante." },
  "glossaireValUsageFourrageDesc": "destinée à nourrir les animaux.",
  "@glossaireValUsageFourrageDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionStadeCroissanceTitre": "Stades de croissance",
  "@glossaireNotionStadeCroissanceTitre": { "description": "Page glossaire StadeCroissance." },
  "glossaireNotionStadeCroissanceDef": "L'app estime le stade d'une plantation à partir de sa date de mise en place et de la durée de culture indiquée sur la fiche. C'est une estimation calendaire, pas une mesure — observez vos plantes, elles ont toujours raison !",
  "@glossaireNotionStadeCroissanceDef": { "description": "Définition." },
  "glossaireNotionStadeCroissanceAstuce": "Le stade est affiché sur chaque plantation, dans le détail de la zone.",
  "@glossaireNotionStadeCroissanceAstuce": { "description": "Astuce 💡." },
  "glossaireValStadeLeveeDesc": "la graine germe et pointe hors du sol (semis uniquement).",
  "@glossaireValStadeLeveeDesc": { "description": "Descriptif StadeCroissance.levee." },
  "glossaireValStadeCroissanceDesc": "la plante développe feuilles, tiges et racines — le gros du cycle.",
  "@glossaireValStadeCroissanceDesc": { "description": "Descriptif StadeCroissance.croissance." },
  "glossaireValStadeMaturationDesc": "la récolte approche : fruits qui grossissent, pommaison…",
  "@glossaireValStadeMaturationDesc": { "description": "Descriptif StadeCroissance.maturation." },
  "glossaireValStadeRecolteDesc": "la fenêtre de récolte estimée est ouverte.",
  "@glossaireValStadeRecolteDesc": { "description": "Descriptif StadeCroissance.recolte." },
  "glossaireNotionMethodeTitre": "Méthodes de mise en place",
  "@glossaireNotionMethodeTitre": { "description": "Page glossaire MethodeMiseEnPlace." },
  "glossaireNotionMethodeDef": "La façon dont une culture démarre : semée en place, semée au chaud puis repiquée, plant acheté, bouture ou division. La méthode influe sur le calendrier — un [[notion.semis-direct-vs-godet|semis direct]] démarre plus tard mais évite le stress du repiquage.",
  "@glossaireNotionMethodeDef": { "description": "Définition (lien wiki)." },
  "glossaireNotionSemisGodetTitre": "Semis direct ou en godet ?",
  "@glossaireNotionSemisGodetTitre": { "description": "Notion transverse (annexe A)." },
  "glossaireNotionSemisGodetDef": "Le semis direct se fait en pleine terre, à l'emplacement définitif : simple, mais exposé au froid, aux limaces et aux oiseaux. Le semis en godet (à l'intérieur ou sous [[outil.tunnel|abri]]) démarre plus tôt au chaud, puis les plants sont repiqués — idéal pour les frileuses (tomates, courges…).",
  "@glossaireNotionSemisGodetDef": { "description": "Définition (lien wiki)." },
  "glossaireNotionSemisGodetAstuce": "Racines pivotantes (carotte, panais, radis…) : toujours en semis direct — le repiquage déforme la racine.",
  "@glossaireNotionSemisGodetAstuce": { "description": "Astuce 💡." },
  "glossaireNotionSemisGodetConseil1": "En godet, endurcissez les plants quelques jours dehors avant le repiquage définitif.",
  "@glossaireNotionSemisGodetConseil1": { "description": "Conseil." },
  "glossaireNotionStatutPlantationTitre": "Statuts d'une plantation",
  "@glossaireNotionStatutPlantationTitre": { "description": "Page glossaire StatutPlantation." },
  "glossaireNotionStatutPlantationDef": "Le cycle de vie d'une plantation dans l'app : en cours tant qu'elle occupe le sol, puis récoltée, échouée ou arrachée. Les plantations terminées restent dans l'historique de la zone — précieux pour la [[notion.rotation-cultures|rotation]].",
  "@glossaireNotionStatutPlantationDef": { "description": "Définition (lien wiki)." },
  "glossaireValStatutEnCours": "En cours",
  "@glossaireValStatutEnCours": { "description": "Valeur StatutPlantation." },
  "glossaireValStatutEnCoursDesc": "la culture occupe la parcelle.",
  "@glossaireValStatutEnCoursDesc": { "description": "Descriptif de la valeur." },
  "glossaireValStatutRecoltee": "Récoltée",
  "@glossaireValStatutRecoltee": { "description": "Valeur StatutPlantation." },
  "glossaireValStatutRecolteeDesc": "cycle terminé par une récolte.",
  "@glossaireValStatutRecolteeDesc": { "description": "Descriptif de la valeur." },
  "glossaireValStatutEchouee": "Échouée",
  "@glossaireValStatutEchouee": { "description": "Valeur StatutPlantation." },
  "glossaireValStatutEchoueeDesc": "la culture n'a pas abouti (gel, maladie…) — notez pourquoi en observation.",
  "@glossaireValStatutEchoueeDesc": { "description": "Descriptif de la valeur." },
  "glossaireValStatutArrachee": "Arrachée",
  "@glossaireValStatutArrachee": { "description": "Valeur StatutPlantation." },
  "glossaireValStatutArracheeDesc": "retirée volontairement avant la récolte.",
  "@glossaireValStatutArracheeDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionPourquoiRecoTitre": "Pourquoi cette plante ? (recommandations)",
  "@glossaireNotionPourquoiRecoTitre": { "description": "Page glossaire RaisonReco." },
  "glossaireNotionPourquoiRecoDef": "Quand l'app recommande une plante, elle liste ses raisons — jamais de boîte noire. Chaque raison correspond à un critère vérifié pour votre potager : saison, exposition, sol, voisines déjà en place, rotation, niveau.",
  "@glossaireNotionPourquoiRecoDef": { "description": "Définition." },
  "glossaireValRecoPlantable": "Plantable en ce moment",
  "@glossaireValRecoPlantable": { "description": "Valeur RaisonReco." },
  "glossaireValRecoPlantableDesc": "la période de semis ou plantation est ouverte dans votre climat.",
  "@glossaireValRecoPlantableDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecoExposition": "Exposition adaptée",
  "@glossaireValRecoExposition": { "description": "Valeur RaisonReco." },
  "glossaireValRecoExpositionDesc": "l'ensoleillement de la parcelle correspond au besoin de la plante.",
  "@glossaireValRecoExpositionDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecoSol": "Sol adapté",
  "@glossaireValRecoSol": { "description": "Valeur RaisonReco." },
  "glossaireValRecoSolDesc": "les qualités du sol de la parcelle correspondent aux besoins de la plante.",
  "@glossaireValRecoSolDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecoAssociation": "Bonne compagnie (documentée)",
  "@glossaireValRecoAssociation": { "description": "Valeur RaisonReco." },
  "glossaireValRecoAssociationDesc": "une compagne bénéfique documentée pousse déjà dans la parcelle.",
  "@glossaireValRecoAssociationDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecoAssociationDerivee": "Bonne compagnie (calculée)",
  "@glossaireValRecoAssociationDerivee": { "description": "Valeur RaisonReco." },
  "glossaireValRecoAssociationDeriveeDesc": "le moteur déduit un bénéfice d'une voisine en place ([[notion.calcul-associations|calcul des associations]]).",
  "@glossaireValRecoAssociationDeriveeDesc": { "description": "Descriptif de la valeur (lien wiki)." },
  "glossaireValRecoRotation": "Rotation respectée",
  "@glossaireValRecoRotation": { "description": "Valeur RaisonReco." },
  "glossaireValRecoRotationDesc": "pas de culture récente de la même famille à cet endroit.",
  "@glossaireValRecoRotationDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecoNiveau": "Niveau adapté",
  "@glossaireValRecoNiveau": { "description": "Valeur RaisonReco." },
  "glossaireValRecoNiveauDesc": "difficulté en phase avec votre niveau d'expérience.",
  "@glossaireValRecoNiveauDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecoVertical": "Support disponible",
  "@glossaireValRecoVertical": { "description": "Valeur RaisonReco." },
  "glossaireValRecoVerticalDesc": "la parcelle offre le support vertical dont la plante profite.",
  "@glossaireValRecoVerticalDesc": { "description": "Descriptif de la valeur." },

  "glossaireNotionBioagresseurTitre": "Maladies & ravageurs",
  "@glossaireNotionBioagresseurTitre": { "description": "Page glossaire TypeBioagresseur." },
  "glossaireNotionBioagresseurDef": "Les « bioagresseurs » regroupent tout ce qui s'attaque aux cultures : maladies (champignons, bactéries, virus…) et ravageurs (insectes, mollusques…). Chaque fiche de ce chapitre décrit un bioagresseur et les [[notion.famille-botanique|familles]] qu'il vise — la clé pour comprendre la [[notion.rotation-cultures|rotation]] et le [[notion.compagnonnage|compagnonnage]].",
  "@glossaireNotionBioagresseurDef": { "description": "Définition (liens wiki)." },
  "glossaireValBioMaladieDesc": "champignons, oomycètes, bactéries, virus… (ex. mildiou).",
  "@glossaireValBioMaladieDesc": { "description": "Descriptif TypeBioagresseur.maladie." },
  "glossaireValBioRavageurDesc": "insectes, acariens, mollusques, nématodes… (ex. puceron).",
  "@glossaireValBioRavageurDesc": { "description": "Descriptif TypeBioagresseur.ravageur." },
  "glossaireNotionPreventionTitre": "Prévention au potager",
  "@glossaireNotionPreventionTitre": { "description": "Notion santé (D1)." },
  "glossaireNotionPreventionDef": "Au potager naturel, on prévient plutôt qu'on ne guérit : un sol vivant, des plantes au bon endroit et de la diversité évitent la plupart des dégâts. La [[notion.rotation-cultures|rotation]], le [[notion.compagnonnage|compagnonnage]], le [[notion.paillage|paillage]] et l'observation régulière sont vos meilleurs outils.",
  "@glossaireNotionPreventionDef": { "description": "Définition (liens wiki)." },
  "glossaireNotionPreventionAstuce": "Notez vos observations dans l'app : l'historique aide à repérer les récidives.",
  "@glossaireNotionPreventionAstuce": { "description": "Astuce 💡." },
  "glossaireNotionPreventionConseil1": "Passez au potager quelques minutes chaque jour : un ravageur repéré tôt se gère à la main.",
  "@glossaireNotionPreventionConseil1": { "description": "Conseil." },
  "glossaireNotionPreventionConseil2": "Attirez les auxiliaires : fleurs mellifères, [[outil.hotel-a-insectes|hôtel à insectes]], point d'eau.",
  "@glossaireNotionPreventionConseil2": { "description": "Conseil (lien wiki)." },

  "glossaireNotionTextureSolTitre": "Textures de sol",
  "@glossaireNotionTextureSolTitre": { "description": "Page glossaire TextureSol (concept)." },
  "glossaireNotionTextureSolDef": "La texture décrit ce qui compose votre terre : argile, sable, limon… Elle conditionne la rétention d'eau, le réchauffement au printemps et la facilité de travail. Chaque texture a sa page — voir ci-dessous.",
  "@glossaireNotionTextureSolDef": { "description": "Définition." },
  "glossaireNotionTextureSolAstuce": "Le test du boudin : roulez une poignée de terre humide. Elle colle et forme un boudin ? L'argile domine. Elle file entre les doigts ? Le sable domine.",
  "@glossaireNotionTextureSolAstuce": { "description": "Astuce 💡." },
  "glossaireSolArgileuxTitre": "Sol argileux",
  "@glossaireSolArgileuxTitre": { "description": "Page texture (1 page/valeur, D1)." },
  "glossaireSolArgileuxDef": "Terre lourde et collante, qui retient bien l'eau et les nutriments mais se réchauffe lentement et se compacte facilement. Fertile une fois amendée, pénible à travailler humide.",
  "@glossaireSolArgileuxDef": { "description": "Définition." },
  "glossaireSolArgileuxConseil1": "Apportez du compost et paillez ; travaillez-la ressuyée, jamais détrempée — la [[notion.grelinette|grelinette]] évite de la retourner.",
  "@glossaireSolArgileuxConseil1": { "description": "Conseil (lien wiki)." },
  "glossaireSolSableuxTitre": "Sol sableux",
  "@glossaireSolSableuxTitre": { "description": "Page texture." },
  "glossaireSolSableuxDef": "Terre légère et drainante, qui se réchauffe vite au printemps mais retient mal l'eau et les nutriments.",
  "@glossaireSolSableuxDef": { "description": "Définition." },
  "glossaireSolSableuxConseil1": "Compost régulier et [[notion.paillage|paillage]] épais pour garder la fraîcheur ; arrosages plus fréquents mais plus légers.",
  "@glossaireSolSableuxConseil1": { "description": "Conseil (lien wiki)." },
  "glossaireSolLimoneuxTitre": "Sol limoneux",
  "@glossaireSolLimoneuxTitre": { "description": "Page texture." },
  "glossaireSolLimoneuxDef": "Terre douce et fertile, équilibrée entre argile et sable — le sol de maraîchage par excellence. Sa structure fragile « bat » sous les fortes pluies : une croûte se forme en surface.",
  "@glossaireSolLimoneuxDef": { "description": "Définition." },
  "glossaireSolLimoneuxConseil1": "Gardez-le couvert ([[notion.paillage|paillage]], [[notion.engrais-vert-couvert|engrais verts]]) pour protéger sa structure.",
  "@glossaireSolLimoneuxConseil1": { "description": "Conseil (liens wiki)." },
  "glossaireSolCalcaireTitre": "Sol calcaire",
  "@glossaireSolCalcaireTitre": { "description": "Page texture." },
  "glossaireSolCalcaireDef": "Terre claire, souvent caillouteuse, au [[notion.ph-sol|pH]] élevé : elle draine bien mais peut bloquer certains éléments (le fer notamment) et sécher vite.",
  "@glossaireSolCalcaireDef": { "description": "Définition (lien wiki)." },
  "glossaireSolCalcaireConseil1": "Matière organique en quantité, paillage, et des plantes qui tolèrent le calcaire (choux, lavande…).",
  "@glossaireSolCalcaireConseil1": { "description": "Conseil." },
  "glossaireSolHumifereTitre": "Sol humifère",
  "@glossaireSolHumifereTitre": { "description": "Page texture." },
  "glossaireSolHumifereDef": "Terre sombre et souple, riche en humus : elle retient l'eau, nourrit généreusement et grouille de vie. C'est l'objectif que visent la plupart des [[notion.techniques-sol|techniques de sol]] de ce lexique.",
  "@glossaireSolHumifereDef": { "description": "Définition (lien wiki)." },
  "glossaireSolHumifereConseil1": "Entretenez-la : [[notion.compostage-surface|compost de surface]] et couverture permanente.",
  "@glossaireSolHumifereConseil1": { "description": "Conseil (lien wiki)." },
  "glossaireSolTourbeuxTitre": "Sol tourbeux",
  "@glossaireSolTourbeuxTitre": { "description": "Page texture." },
  "glossaireSolTourbeuxDef": "Terre très riche en matière organique peu décomposée, acide et spongieuse. Elle retient énormément d'eau, mais une fois desséchée elle est difficile à réhumecter.",
  "@glossaireSolTourbeuxDef": { "description": "Définition." },
  "glossaireSolTourbeuxConseil1": "Corrigez l'acidité si besoin (cendres, chaux) et drainez les excès d'eau.",
  "@glossaireSolTourbeuxConseil1": { "description": "Conseil." },
  "glossaireSolCaillouteuxTitre": "Sol caillouteux",
  "@glossaireSolCaillouteuxTitre": { "description": "Page texture." },
  "glossaireSolCaillouteuxDef": "Terre mêlée de pierres : drainage excellent et réchauffement rapide — les cailloux restituent même la chaleur la nuit — mais peu de réserve d'eau et travail malaisé.",
  "@glossaireSolCaillouteuxDef": { "description": "Définition." },
  "glossaireSolCaillouteuxConseil1": "Inutile de tout épierrer : cultivez en [[notion.butte-permanente|buttes]] ou en bacs par-dessus.",
  "@glossaireSolCaillouteuxConseil1": { "description": "Conseil (lien wiki)." },
  "glossaireNotionPhSolTitre": "pH du sol",
  "@glossaireNotionPhSolTitre": { "description": "Page glossaire PhSol." },
  "glossaireNotionPhSolDef": "Le pH mesure l'acidité de la terre, d'acide à alcalin (calcaire). La plupart des légumes préfèrent un sol neutre à légèrement acide ; certaines plantes exigent un sol franchement acide (myrtille) ou tolèrent bien le calcaire (choux). Les fiches indiquent la préférence de chaque plante.",
  "@glossaireNotionPhSolDef": { "description": "Définition." },
  "glossaireValPhAcideDesc": "pH sous 6,5 — là où mousse et prêle se plaisent.",
  "@glossaireValPhAcideDesc": { "description": "Descriptif PhSol.acide." },
  "glossaireValPhNeutreDesc": "pH entre 6,5 et 7,5 — la zone de confort de la plupart des légumes.",
  "@glossaireValPhNeutreDesc": { "description": "Descriptif PhSol.neutre." },
  "glossaireValPhAlcalinDesc": "pH au-delà de 7,5 — typique des sols calcaires.",
  "@glossaireValPhAlcalinDesc": { "description": "Descriptif PhSol.alcalin." },
  "glossaireNotionQualiteSolTitre": "Qualités du sol",
  "@glossaireNotionQualiteSolTitre": { "description": "Page glossaire QualiteSol." },
  "glossaireNotionQualiteSolDef": "Au-delà de la texture, les fiches décrivent le sol que chaque plante recherche par des qualités simples : riche ou pauvre, drainé ou humide, frais ou sec, lourd ou léger. L'app confronte ces attentes à ce que vous savez de votre parcelle.",
  "@glossaireNotionQualiteSolDef": { "description": "Définition." },
  "glossaireValQualiteRiche": "Riche",
  "@glossaireValQualiteRiche": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteRicheDesc": "bien pourvu en nutriments (compost, fumier).",
  "@glossaireValQualiteRicheDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualitePauvre": "Pauvre",
  "@glossaireValQualitePauvre": { "description": "Valeur QualiteSol." },
  "glossaireValQualitePauvreDesc": "peu de nutriments — certaines plantes préfèrent (capucine…).",
  "@glossaireValQualitePauvreDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualiteBienDraine": "Bien drainé",
  "@glossaireValQualiteBienDraine": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteBienDraineDesc": "l'eau ne stagne pas.",
  "@glossaireValQualiteBienDraineDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualiteMalDraine": "Mal drainé",
  "@glossaireValQualiteMalDraine": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteMalDraineDesc": "l'eau stagne facilement.",
  "@glossaireValQualiteMalDraineDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualiteFrais": "Frais",
  "@glossaireValQualiteFrais": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteFraisDesc": "reste humide en profondeur, sans excès.",
  "@glossaireValQualiteFraisDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualiteSec": "Sec",
  "@glossaireValQualiteSec": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteSecDesc": "sèche vite entre deux pluies.",
  "@glossaireValQualiteSecDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualiteLourd": "Lourd",
  "@glossaireValQualiteLourd": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteLourdDesc": "compact, à dominante argileuse.",
  "@glossaireValQualiteLourdDesc": { "description": "Descriptif de la valeur." },
  "glossaireValQualiteLeger": "Léger",
  "@glossaireValQualiteLeger": { "description": "Valeur QualiteSol." },
  "glossaireValQualiteLegerDesc": "meuble et aéré, à dominante sableuse.",
  "@glossaireValQualiteLegerDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionSourceSolTitre": "D'où vient le type de sol ?",
  "@glossaireNotionSourceSolTitre": { "description": "Page glossaire SourceTypeSol." },
  "glossaireNotionSourceSolDef": "L'app garde la trace de l'origine du type de sol d'une parcelle : saisi par vous, ou déduit automatiquement. Une valeur déduite reste une estimation grossière — votre observation du terrain vaut toujours mieux.",
  "@glossaireNotionSourceSolDef": { "description": "Définition." },
  "glossaireNotionSourceSolAstuce": "Faites le test du boudin (voir [[notion.texture-sol|textures de sol]]) et corrigez la valeur déduite si besoin.",
  "@glossaireNotionSourceSolAstuce": { "description": "Astuce 💡 (lien wiki)." },
  "glossaireValSourceManuelle": "Saisi manuellement",
  "@glossaireValSourceManuelle": { "description": "Valeur SourceTypeSol." },
  "glossaireValSourceManuelleDesc": "vous l'avez renseigné vous-même.",
  "@glossaireValSourceManuelleDesc": { "description": "Descriptif de la valeur." },
  "glossaireValSourceLocalisation": "Déduit de la localisation",
  "@glossaireValSourceLocalisation": { "description": "Valeur SourceTypeSol." },
  "glossaireValSourceLocalisationDesc": "estimé d'après votre position.",
  "@glossaireValSourceLocalisationDesc": { "description": "Descriptif de la valeur." },
  "glossaireValSourceClimat": "Déduit du climat",
  "@glossaireValSourceClimat": { "description": "Valeur SourceTypeSol." },
  "glossaireValSourceClimatDesc": "estimé d'après votre type de climat.",
  "@glossaireValSourceClimatDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionTechniquesSolTitre": "Techniques de sol",
  "@glossaireNotionTechniquesSolTitre": { "description": "Page glossaire TechniqueSol (concept)." },
  "glossaireNotionTechniquesSolDef": "Le sol vivant se cultive autant que les plantes ! Buttes, paillages, composts et couvertures nourrissent la terre, stockent l'eau et hébergent la vie. Chaque technique a sa page — commencez par le [[notion.paillage|paillage]] et le [[notion.compostage-surface|compostage de surface]], les plus simples.",
  "@glossaireNotionTechniquesSolDef": { "description": "Définition (liens wiki)." },
  "glossaireTechButteLasagneDef": "Butte montée en couches alternées de matières brunes (carton, feuilles mortes, bois) et vertes (tontes, déchets de cuisine), coiffées de compost : on plante dedans dès la première année, pendant que la butte se composte sur place.",
  "@glossaireTechButteLasagneDef": { "description": "Page technique de sol (1 page/valeur, D1)." },
  "glossaireTechButteLasagneConseil1": "Idéale pour démarrer sur une pelouse ou un sol pauvre, sans le travailler — le [[notion.carton|carton]] en première couche étouffe l'herbe.",
  "@glossaireTechButteLasagneConseil1": { "description": "Conseil (lien wiki)." },
  "glossaireTechHugelkulturDef": "Butte bâtie sur du bois mort enterré (troncs, grosses branches) : en se décomposant, le bois éponge l'eau, nourrit le sol des années durant et réchauffe la butte.",
  "@glossaireTechHugelkulturDef": { "description": "Page technique de sol." },
  "glossaireTechHugelkulturAstuce": "Moins d'arrosage dès la deuxième année : le bois enterré joue les réserves d'eau.",
  "@glossaireTechHugelkulturAstuce": { "description": "Astuce 💡." },
  "glossaireTechButteRondeDef": "Butte bombée qui augmente la surface de culture et draine naturellement les pluies vers les allées. On plante le sommet et les flancs.",
  "@glossaireTechButteRondeDef": { "description": "Page technique de sol." },
  "glossaireTechButtePermanenteDef": "Butte jamais retournée ni piétinée : la structure du sol se construit d'année en année, entretenue par les racines, les vers et les apports de surface.",
  "@glossaireTechButtePermanenteDef": { "description": "Page technique de sol." },
  "glossaireTechPaillageDef": "Couvrir le sol (paille, feuilles mortes, tontes sèches, [[notion.brf|BRF]]…) pour garder l'humidité, bloquer les indésirables et nourrir la vie du sol en se décomposant. Le geste le plus rentable du potager.",
  "@glossaireTechPaillageDef": { "description": "Page technique de sol — notion transverse « paillage » (annexe A)." },
  "glossaireTechPaillageAstuce": "Comptez 5 à 10 cm d'épaisseur ; ne paillez jamais un sol sec ou gelé.",
  "@glossaireTechPaillageAstuce": { "description": "Astuce 💡." },
  "glossaireTechPaillageConseil1": "Un sol paillé s'arrose moins souvent mais plus copieusement.",
  "@glossaireTechPaillageConseil1": { "description": "Conseil." },
  "glossaireTechBrfDef": "Bois raméal fragmenté : broyat de jeunes branches épandu en couche fine, qui relance la vie fongique du sol et fabrique de l'humus durable.",
  "@glossaireTechBrfDef": { "description": "Page technique de sol." },
  "glossaireTechBrfConseil1": "Épandez à l'automne et n'enfouissez pas : le BRF se composte en surface. Une « faim d'azote » passagère est possible la première année.",
  "@glossaireTechBrfConseil1": { "description": "Conseil." },
  "glossaireTechMulchVivantDef": "Couvrir le sol de plantes basses vivantes (trèfle blanc…) plutôt que de paille : la couverture pousse toute seule, fixe parfois l'azote et protège en continu.",
  "@glossaireTechMulchVivantDef": { "description": "Page technique de sol." },
  "glossaireTechEngraisVertCouvertDef": "Semer une culture qu'on ne récolte pas (phacélie, moutarde, vesce…) pour couvrir et nourrir le sol entre deux cultures ; on la fauche avant la montée en graines et on la laisse en paillage.",
  "@glossaireTechEngraisVertCouvertDef": { "description": "Page technique de sol." },
  "glossaireTechPaillageMineralDef": "Paillage de pierres, graviers ou ardoises : durable, il stocke la chaleur du jour et la restitue la nuit — adapté aux aromatiques méditerranéennes, pas aux gourmandes en humus.",
  "@glossaireTechPaillageMineralDef": { "description": "Page technique de sol." },
  "glossaireTechCartonDef": "Le carton brun posé au sol étouffe l'herbe et se composte lentement : la première couche des [[notion.butte-lasagne|lasagnes]] et l'arme douce pour convertir une pelouse en potager sans bêcher.",
  "@glossaireTechCartonDef": { "description": "Page technique de sol (lien wiki)." },
  "glossaireTechCartonConseil1": "Retirez rubans adhésifs et encres brillantes, et recouvrez-le pour qu'il ne s'envole pas.",
  "@glossaireTechCartonConseil1": { "description": "Conseil." },
  "glossaireTechNoDigDef": "Ne jamais retourner le sol : on nourrit par le dessus (compost, paillages) et on laisse vers et racines structurer la terre. Moins d'effort, moins d'herbes indésirables, un sol de plus en plus vivant.",
  "@glossaireTechNoDigDef": { "description": "Page technique de sol." },
  "glossaireTechGrelinetteDef": "Fourche à deux manches qui aère le sol sans le retourner : les horizons et la vie du sol restent en place — et votre dos vous dit merci.",
  "@glossaireTechGrelinetteDef": { "description": "Page technique de sol." },
  "glossaireTechGrelinetteAstuce": "L'outil emblématique du potager [[notion.no-dig|sans labour]].",
  "@glossaireTechGrelinetteAstuce": { "description": "Astuce 💡 (lien wiki)." },
  "glossaireTechMulchDeFoinDef": "Paillage épais de foin : plus nourrissant que la paille et très efficace contre la sécheresse ; il peut toutefois ressemer ses graines.",
  "@glossaireTechMulchDeFoinDef": { "description": "Page technique de sol." },
  "glossaireTechCompostageSurfaceDef": "Déposer les déchets organiques directement au pied des cultures : la vie du sol les digère sur place, sans tas de compost à gérer.",
  "@glossaireTechCompostageSurfaceDef": { "description": "Page technique de sol." },
  "glossaireTechCompostEnTrouDef": "Enterrer les déchets de cuisine dans un trou entre les cultures : discret, rapide, et les nutriments arrivent directement aux racines.",
  "@glossaireTechCompostEnTrouDef": { "description": "Page technique de sol." },
  "glossaireTechMycorhizationDef": "Favoriser (ou inoculer) les champignons mycorhiziens qui s'associent aux racines : ils démultiplient l'absorption d'eau et de phosphore, contre un peu de sucre. Un sol non travaillé les préserve.",
  "@glossaireTechMycorhizationDef": { "description": "Page technique de sol." },
  "glossaireTechBokashiDef": "Fermentation des déchets de cuisine en seau clos avec un ferment (son inoculé) : en quelques semaines, un pré-compost à enterrer — il accepte même viande et agrumes.",
  "@glossaireTechBokashiDef": { "description": "Page technique de sol." },
  "glossaireTechSwalesDef": "Fossés horizontaux creusés sur les courbes de niveau, doublés d'un talus planté : ils freinent l'eau de pluie et l'infiltrent dans le sol au lieu de la laisser ruisseler.",
  "@glossaireTechSwalesDef": { "description": "Page technique de sol." },
  "glossaireTechKeylineDesignDef": "Méthode d'aménagement qui lit le relief (les « lignes clés ») pour répartir l'eau de pluie des creux vers les crêtes, via des sillons presque horizontaux. Surtout pertinente sur grande surface pentue.",
  "@glossaireTechKeylineDesignDef": { "description": "Page technique de sol." },
  "glossaireNotionEnracinementTitre": "Enracinement",
  "@glossaireNotionEnracinementTitre": { "description": "Page glossaire EnracinementPlante." },
  "glossaireNotionEnracinementDef": "La profondeur des racines décide de qui boit et mange à quel étage : superficielles et profondes cohabitent bien au lieu de se concurrencer ([[notion.meca-ameublissement-sol|ameublissement du sol]]). Elle joue aussi sur la résistance à la sécheresse.",
  "@glossaireNotionEnracinementDef": { "description": "Définition (lien wiki)." },
  "glossaireValEnracinementSuperficielDesc": "racines dans les premiers centimètres (salades, oignons…).",
  "@glossaireValEnracinementSuperficielDesc": { "description": "Descriptif EnracinementPlante.superficiel." },
  "glossaireValEnracinementMoyenDesc": "profondeur intermédiaire — la plupart des légumes.",
  "@glossaireValEnracinementMoyenDesc": { "description": "Descriptif EnracinementPlante.moyen." },
  "glossaireValEnracinementProfondDesc": "les racines descendent chercher l'eau en profondeur (tomate, courge…).",
  "@glossaireValEnracinementProfondDesc": { "description": "Descriptif EnracinementPlante.profond." },
  "glossaireValEnracinementPivotantDesc": "une racine principale qui plonge à la verticale (carotte, panais…).",
  "@glossaireValEnracinementPivotantDesc": { "description": "Descriptif EnracinementPlante.pivotant." },
  "glossaireNotionBesoinNutrimentsTitre": "Besoin en nutriments (azote…)",
  "@glossaireNotionBesoinNutrimentsTitre": { "description": "Page glossaire NiveauBesoin." },
  "glossaireNotionBesoinNutrimentsDef": "Certaines plantes sont gourmandes (choux, courges), d'autres frugales (carottes) — l'azote est le nutriment clé. Le moteur d'associations s'en sert : une gourmande profite d'une voisine qui [[notion.meca-fixation-azote|fixe l'azote]], deux gourmandes côte à côte se concurrencent ([[notion.meca-competition-azote|concurrence azote]]).",
  "@glossaireNotionBesoinNutrimentsDef": { "description": "Définition (liens wiki)." },
  "glossaireValBesoinFaible": "Faible",
  "@glossaireValBesoinFaible": { "description": "Valeur NiveauBesoin." },
  "glossaireValBesoinFaibleDesc": "plante frugale : un sol ordinaire suffit.",
  "@glossaireValBesoinFaibleDesc": { "description": "Descriptif de la valeur." },
  "glossaireValBesoinModere": "Modéré",
  "@glossaireValBesoinModere": { "description": "Valeur NiveauBesoin." },
  "glossaireValBesoinModereDesc": "besoin moyen.",
  "@glossaireValBesoinModereDesc": { "description": "Descriptif de la valeur." },
  "glossaireValBesoinEleve": "Élevé",
  "@glossaireValBesoinEleve": { "description": "Valeur NiveauBesoin." },
  "glossaireValBesoinEleveDesc": "plante gourmande : compost bienvenu.",
  "@glossaireValBesoinEleveDesc": { "description": "Descriptif de la valeur." },

  "glossaireNotionBesoinEauTitre": "Besoins en eau",
  "@glossaireNotionBesoinEauTitre": { "description": "Page glossaire BesoinEau." },
  "glossaireNotionBesoinEauDef": "Chaque fiche classe la soif de la plante. Combinée à la météo, à la [[notion.tolerance-secheresse|tolérance à la sécheresse]] et à l'[[notion.evapotranspiration|évapotranspiration]], elle permet à l'app de calculer l'[[notion.urgence-arrosage|urgence d'arrosage]] de chaque plantation.",
  "@glossaireNotionBesoinEauDef": { "description": "Définition (liens wiki)." },
  "glossaireNotionBesoinEauAstuce": "Le [[notion.paillage|paillage]] réduit nettement les besoins d'arrosage.",
  "@glossaireNotionBesoinEauAstuce": { "description": "Astuce 💡 (lien wiki)." },
  "glossaireNotionBesoinEauConseil1": "Arrosez moins souvent mais copieusement : les racines descendent chercher l'eau et la plante gagne en autonomie.",
  "@glossaireNotionBesoinEauConseil1": { "description": "Conseil." },
  "glossaireValEauFaibleDesc": "se contente des pluies, hors longue sécheresse.",
  "@glossaireValEauFaibleDesc": { "description": "Descriptif BesoinEau.faible." },
  "glossaireValEauModereDesc": "arrosages réguliers en saison sèche.",
  "@glossaireValEauModereDesc": { "description": "Descriptif BesoinEau.modere." },
  "glossaireValEauEleveDesc": "ne doit jamais manquer d'eau (céleri, cultures en pot…).",
  "@glossaireValEauEleveDesc": { "description": "Descriptif BesoinEau.eleve." },
  "glossaireNotionUrgenceArrosageTitre": "Urgence d'arrosage",
  "@glossaireNotionUrgenceArrosageTitre": { "description": "Page glossaire UrgenceArrosage (ADR-0015)." },
  "glossaireNotionUrgenceArrosageDef": "Pour chaque plantation, l'app croise la chaleur des derniers jours, la pluie tombée et annoncée, l'[[notion.evapotranspiration|évapotranspiration]] et la soif propre de la plante pour dire s'il faut arroser. Quand c'est urgent, une tâche d'arrosage est créée automatiquement.",
  "@glossaireNotionUrgenceArrosageDef": { "description": "Définition (lien wiki)." },
  "glossaireValUrgenceMaintenant": "Arroser maintenant",
  "@glossaireValUrgenceMaintenant": { "description": "Valeur UrgenceArrosage." },
  "glossaireValUrgenceMaintenantDesc": "le sol est sec et la demande de la plante est forte.",
  "@glossaireValUrgenceMaintenantDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUrgenceBientot": "Bientôt",
  "@glossaireValUrgenceBientot": { "description": "Valeur UrgenceArrosage." },
  "glossaireValUrgenceBientotDesc": "à surveiller : prévoyez d'arroser dans les prochains jours.",
  "@glossaireValUrgenceBientotDesc": { "description": "Descriptif de la valeur." },
  "glossaireValUrgencePasNecessaire": "Pas nécessaire",
  "@glossaireValUrgencePasNecessaire": { "description": "Valeur UrgenceArrosage." },
  "glossaireValUrgencePasNecessaireDesc": "pluie récente ou prévue, ou réserve d'eau suffisante.",
  "@glossaireValUrgencePasNecessaireDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionToleranceSecheresseTitre": "Tolérance à la sécheresse",
  "@glossaireNotionToleranceSecheresseTitre": { "description": "Page glossaire ToleranceSecheresse." },
  "glossaireNotionToleranceSecheresseDef": "Certaines plantes encaissent un oubli d'arrosage (romarin), d'autres le paient cash (céleri). L'app en tient compte : une plante sensible voit son [[notion.urgence-arrosage|urgence d'arrosage]] monter plus vite, une plante tolérante peut attendre.",
  "@glossaireNotionToleranceSecheresseDef": { "description": "Définition (lien wiki)." },
  "glossaireValToleranceFaible": "Faible",
  "@glossaireValToleranceFaible": { "description": "Valeur ToleranceSecheresse." },
  "glossaireValToleranceFaibleDesc": "sensible : le stress apparaît vite sans eau.",
  "@glossaireValToleranceFaibleDesc": { "description": "Descriptif de la valeur." },
  "glossaireValToleranceMoyenne": "Moyenne",
  "@glossaireValToleranceMoyenne": { "description": "Valeur ToleranceSecheresse." },
  "glossaireValToleranceMoyenneDesc": "tolérance ordinaire.",
  "@glossaireValToleranceMoyenneDesc": { "description": "Descriptif de la valeur." },
  "glossaireValToleranceForte": "Forte",
  "@glossaireValToleranceForte": { "description": "Valeur ToleranceSecheresse." },
  "glossaireValToleranceForteDesc": "supporte d'attendre entre deux arrosages.",
  "@glossaireValToleranceForteDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionEvapotranspirationTitre": "Évapotranspiration (ET₀)",
  "@glossaireNotionEvapotranspirationTitre": { "description": "Notion transverse ET₀ (annexe A)." },
  "glossaireNotionEvapotranspirationDef": "L'eau que perd chaque jour un sol cultivé : évaporation de la terre + transpiration des plantes. La météo fournit à l'app cette valeur de référence (ET₀), qui traduit la « demande » du climat : plus elle est haute (chaud, sec, venteux), plus vite le sol se vide et plus l'arrosage presse.",
  "@glossaireNotionEvapotranspirationDef": { "description": "Définition." },
  "glossaireNotionEvapotranspirationAstuce": "Par forte ET₀, arrosez tôt le matin ou le soir : moins de pertes par évaporation.",
  "@glossaireNotionEvapotranspirationAstuce": { "description": "Astuce 💡." },

  "glossaireOutilOyaTitre": "Oya",
  "@glossaireOutilOyaTitre": { "description": "Page outil TypeEquipement.oya (1 page/valeur)." },
  "glossaireOutilOyaDef": "Pot en terre cuite microporeuse, enterré près des cultures et rempli d'eau : l'humidité diffuse lentement à travers la paroi, directement aux racines. Un arrosage très économe, idéal en pot et en climat sec.",
  "@glossaireOutilOyaDef": { "description": "Définition." },
  "glossaireOutilOyaAstuce": "Remplissez l'oya tous les 2 à 5 jours selon la chaleur ; paillez autour pour encore moins de pertes.",
  "@glossaireOutilOyaAstuce": { "description": "Astuce 💡." },
  "glossaireOutilGoutteAGoutteTitre": "Goutte-à-goutte",
  "@glossaireOutilGoutteAGoutteTitre": { "description": "Page outil TypeEquipement.gouttesAGoutte." },
  "glossaireOutilGoutteAGoutteDef": "Réseau de tuyaux munis de goutteurs qui délivrent l'eau lentement au pied des plantes : peu d'évaporation, pas de feuillage mouillé (moins de maladies), et l'automatisation devient possible.",
  "@glossaireOutilGoutteAGoutteDef": { "description": "Définition." },
  "glossaireOutilGoutteAGoutteConseil1": "Arrosez longtemps mais rarement, et vérifiez régulièrement que les goutteurs ne sont pas bouchés.",
  "@glossaireOutilGoutteAGoutteConseil1": { "description": "Conseil." },
  "glossaireOutilTuteurTitre": "Tuteur",
  "@glossaireOutilTuteurTitre": { "description": "Page outil TypeEquipement.tuteur." },
  "glossaireOutilTuteurDef": "Support vertical (bambou, bois, métal) qui guide les plantes hautes ou grimpantes : feuillage mieux aéré, fruits propres, récolte facile. Chaque grimpante impose une charge différente à son support :",
  "@glossaireOutilTuteurDef": { "description": "Définition (suivie du bloc valeurs ChargeTuteur)." },
  "glossaireOutilTuteurAstuce": "Plantez le tuteur en même temps que le plant : enfoncé plus tard, il blesserait les racines.",
  "@glossaireOutilTuteurAstuce": { "description": "Astuce 💡." },
  "glossaireValChargeLegere": "Charge légère",
  "@glossaireValChargeLegere": { "description": "Valeur ChargeTuteur." },
  "glossaireValChargeLegereDesc": "haricot à rames, pois…",
  "@glossaireValChargeLegereDesc": { "description": "Descriptif de la valeur." },
  "glossaireValChargeMoyenne": "Charge moyenne",
  "@glossaireValChargeMoyenne": { "description": "Valeur ChargeTuteur." },
  "glossaireValChargeMoyenneDesc": "concombre, petit melon…",
  "@glossaireValChargeMoyenneDesc": { "description": "Descriptif de la valeur." },
  "glossaireValChargeLourde": "Charge lourde",
  "@glossaireValChargeLourde": { "description": "Valeur ChargeTuteur." },
  "glossaireValChargeLourdeDesc": "courges coureuses et autres grimpantes vigoureuses.",
  "@glossaireValChargeLourdeDesc": { "description": "Descriptif de la valeur." },
  "glossaireOutilTreillisTitre": "Treillis",
  "@glossaireOutilTreillisTitre": { "description": "Page outil TypeEquipement.treillis." },
  "glossaireOutilTreillisDef": "Grille ou maillage vertical où s'accrochent vrilles et tiges volubiles : concombres, pois et haricots grimpent, et le sol reste libre — un vrai gain de place et de lumière.",
  "@glossaireOutilTreillisDef": { "description": "Définition." },
  "glossaireOutilTunnelTitre": "Tunnel",
  "@glossaireOutilTunnelTitre": { "description": "Page outil TypeEquipement.tunnel." },
  "glossaireOutilTunnelDef": "Arceaux couverts d'un voile ou d'un film plastique formant un abri bas au-dessus d'un rang : quelques degrés gagnés, des semis avancés au printemps et prolongés à l'automne.",
  "@glossaireOutilTunnelDef": { "description": "Définition." },
  "glossaireOutilTunnelConseil1": "Aérez dès que le soleil tape : la température grimpe très vite sous plastique.",
  "@glossaireOutilTunnelConseil1": { "description": "Conseil." },
  "glossaireOutilSerreSemisTitre": "Serre à semis",
  "@glossaireOutilSerreSemisTitre": { "description": "Page outil TypeEquipement.serreSemis." },
  "glossaireOutilSerreSemisDef": "Petite serre (ou mini-serre d'intérieur) dédiée aux semis : chaleur et humidité stables pour des levées précoces et régulières, avant repiquage au potager.",
  "@glossaireOutilSerreSemisDef": { "description": "Définition." },
  "glossaireOutilChassisTitre": "Châssis",
  "@glossaireOutilChassisTitre": { "description": "Page outil TypeEquipement.chassis." },
  "glossaireOutilChassisDef": "Coffre bas vitré, posé au sol et incliné vers le soleil : l'abri des anciens maraîchers, parfait pour semer tôt et endurcir les plants avant la pleine terre.",
  "@glossaireOutilChassisDef": { "description": "Définition." },
  "glossaireOutilClocheTitre": "Cloche",
  "@glossaireOutilClocheTitre": { "description": "Page outil TypeEquipement.cloche." },
  "glossaireOutilClocheDef": "Dôme de verre ou de plastique posé sur une jeune plante : un mini-climat protégé du froid et des limaces pendant les premières semaines.",
  "@glossaireOutilClocheDef": { "description": "Définition." },
  "glossaireOutilClocheConseil1": "Ôtez-la ou aérez par temps doux, pour éviter la surchauffe et la condensation.",
  "@glossaireOutilClocheConseil1": { "description": "Conseil." },
  "glossaireOutilVoileHivernageTitre": "Voile d'hivernage",
  "@glossaireOutilVoileHivernageTitre": { "description": "Page outil TypeEquipement.voileHivernage." },
  "glossaireOutilVoileHivernageDef": "Textile léger et respirant posé sur les cultures : 2 à 4 °C gagnés contre le gel, tout en laissant passer l'air, l'eau et la lumière.",
  "@glossaireOutilVoileHivernageDef": { "description": "Définition." },
  "glossaireOutilVoileHivernageAstuce": "Doublez le voile lors des gels annoncés — l'app vous prévient via les [[notion.alertes-meteo|alertes météo]].",
  "@glossaireOutilVoileHivernageAstuce": { "description": "Astuce 💡 (lien wiki)." },
  "glossaireOutilFiletAntiInsecteTitre": "Filet anti-insectes",
  "@glossaireOutilFiletAntiInsecteTitre": { "description": "Page outil TypeEquipement.filetAntiInsecte." },
  "glossaireOutilFiletAntiInsecteDef": "Maille fine posée sur arceaux qui barre la route aux ravageurs volants (mouche de la carotte, piéride du chou, altises) — sans aucun traitement.",
  "@glossaireOutilFiletAntiInsecteDef": { "description": "Définition." },
  "glossaireOutilFiletAntiInsecteConseil1": "Posez-le dès le semis et bordez-le soigneusement : posé après la ponte, il enferme le ravageur avec la culture.",
  "@glossaireOutilFiletAntiInsecteConseil1": { "description": "Conseil." },
  "glossaireOutilHotelInsectesTitre": "Hôtel à insectes",
  "@glossaireOutilHotelInsectesTitre": { "description": "Page outil TypeEquipement.hotelInsectes." },
  "glossaireOutilHotelInsectesDef": "Abri à compartiments (tiges creuses, bois percé, paille) qui héberge les auxiliaires : abeilles solitaires, chrysopes, coccinelles… La biodiversité qui travaille pour le potager ([[notion.meca-attraction-auxiliaires|attirer les auxiliaires]]).",
  "@glossaireOutilHotelInsectesDef": { "description": "Définition (lien wiki)." },
  "glossaireOutilHotelInsectesConseil1": "Orientez-le au soleil levant, à l'abri de la pluie, près des fleurs.",
  "@glossaireOutilHotelInsectesConseil1": { "description": "Conseil." },
  "glossaireOutilComposteurTitre": "Composteur",
  "@glossaireOutilComposteurTitre": { "description": "Page outil TypeEquipement.composteur." },
  "glossaireOutilComposteurDef": "Bac ou silo où déchets verts et bruns se transforment en compost : l'or noir qui nourrit toutes les terres — voir les [[notion.qualite-sol|qualités du sol]].",
  "@glossaireOutilComposteurDef": { "description": "Définition (lien wiki)." },
  "glossaireOutilComposteurConseil1": "Équilibrez matières humides (tontes, épluchures) et sèches (feuilles mortes, carton), et aérez de temps en temps.",
  "@glossaireOutilComposteurConseil1": { "description": "Conseil." },
  "glossaireOutilRecuperateurEauTitre": "Récupérateur d'eau",
  "@glossaireOutilRecuperateurEauTitre": { "description": "Page outil TypeEquipement.recuperateurEau." },
  "glossaireOutilRecuperateurEauDef": "Cuve raccordée à une gouttière qui stocke l'eau de pluie : gratuite, à température ambiante et sans chlore — les plantes préfèrent.",
  "@glossaireOutilRecuperateurEauDef": { "description": "Définition." },
  "glossaireOutilRecuperateurEauAstuce": "Couvrez la cuve : ni moustiques, ni algues.",
  "@glossaireOutilRecuperateurEauAstuce": { "description": "Astuce 💡." },
  "glossaireNotionEtatEquipementTitre": "États d'un équipement",
  "@glossaireNotionEtatEquipementTitre": { "description": "Page glossaire EtatEquipement." },
  "glossaireNotionEtatEquipementDef": "Les équipements du potager s'usent ; cette échelle décrit leur état, du neuf au hors service, pour anticiper réparations et remplacements.",
  "@glossaireNotionEtatEquipementDef": { "description": "Définition." },
  "glossaireValEtatNeuf": "Neuf",
  "@glossaireValEtatNeuf": { "description": "Valeur EtatEquipement." },
  "glossaireValEtatBon": "Bon état",
  "@glossaireValEtatBon": { "description": "Valeur EtatEquipement." },
  "glossaireValEtatUse": "Usé",
  "@glossaireValEtatUse": { "description": "Valeur EtatEquipement." },
  "glossaireValEtatARemplacer": "À remplacer",
  "@glossaireValEtatARemplacer": { "description": "Valeur EtatEquipement." },
  "glossaireValEtatHorsService": "Hors service",
  "@glossaireValEtatHorsService": { "description": "Valeur EtatEquipement." },

  "glossaireNotionTypeClimatTitre": "Types de climat",
  "@glossaireNotionTypeClimatTitre": { "description": "Page glossaire TypeClimat." },
  "glossaireNotionTypeClimatDef": "Le climat de votre potager décide des périodes de semis et de plantation : les fiches indiquent leurs périodes par climat et par [[notion.hemisphere-saisons|hémisphère]]. L'app le déduit de votre localisation à l'accueil — modifiable dans les réglages.",
  "@glossaireNotionTypeClimatDef": { "description": "Définition (lien wiki)." },
  "glossaireNotionZoneRusticiteTitre": "Zones de rusticité",
  "@glossaireNotionZoneRusticiteTitre": { "description": "Page glossaire ZoneRusticite." },
  "glossaireNotionZoneRusticiteDef": "Échelle (USDA) qui classe les régions selon la température minimale moyenne de l'hiver : zone 1 la plus froide, zone 13 la plus douce. Une plante « rustique en zone 8 » survit à l'hiver d'une zone 8 ou plus douce. L'app estime votre zone d'après votre localisation.",
  "@glossaireNotionZoneRusticiteDef": { "description": "Définition." },
  "glossaireNotionHemisphereTitre": "Hémisphères & saisons inversées",
  "@glossaireNotionHemisphereTitre": { "description": "Page glossaire Hemisphere + notion transverse (annexe A)." },
  "glossaireNotionHemisphereDef": "Les saisons sont inversées d'un hémisphère à l'autre : juillet est un mois d'été au nord, d'hiver au sud. Les calendriers de culture de l'app sont indexés par hémisphère — vos périodes de semis suivent automatiquement le bon calendrier.",
  "@glossaireNotionHemisphereDef": { "description": "Définition." },
  "glossaireValHemisphereNord": "Hémisphère nord",
  "@glossaireValHemisphereNord": { "description": "Valeur Hemisphere." },
  "glossaireValHemisphereNordDesc": "l'été bat son plein autour de juillet.",
  "@glossaireValHemisphereNordDesc": { "description": "Descriptif de la valeur." },
  "glossaireValHemisphereSud": "Hémisphère sud",
  "@glossaireValHemisphereSud": { "description": "Valeur Hemisphere." },
  "glossaireValHemisphereSudDesc": "l'été bat son plein autour de janvier.",
  "@glossaireValHemisphereSudDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionAlertesMeteoTitre": "Alertes météo",
  "@glossaireNotionAlertesMeteoTitre": { "description": "Page glossaire TypeAlerteMeteo." },
  "glossaireNotionAlertesMeteoDef": "L'app surveille les prévisions et vous alerte quand vos cultures en place risquent gros : gel, canicule ou forte pluie. À vous les gestes de protection : [[outil.voile-hivernage|voile]], ombrage, tuteurs renforcés…",
  "@glossaireNotionAlertesMeteoDef": { "description": "Définition (lien wiki)." },
  "glossaireValAlerteGel": "Gel",
  "@glossaireValAlerteGel": { "description": "Valeur TypeAlerteMeteo." },
  "glossaireValAlerteGelDesc": "température minimale prévue sous le seuil : sortez les voiles.",
  "@glossaireValAlerteGelDesc": { "description": "Descriptif de la valeur." },
  "glossaireValAlerteCanicule": "Canicule",
  "@glossaireValAlerteCanicule": { "description": "Valeur TypeAlerteMeteo." },
  "glossaireValAlerteCaniculeDesc": "chaleur extrême prévue : ombrez et arrosez tôt le matin.",
  "@glossaireValAlerteCaniculeDesc": { "description": "Descriptif de la valeur." },
  "glossaireValAlerteFortePluie": "Forte pluie",
  "@glossaireValAlerteFortePluie": { "description": "Valeur TypeAlerteMeteo." },
  "glossaireValAlerteFortePluieDesc": "précipitations importantes prévues : tuteurez, et inutile d'arroser.",
  "@glossaireValAlerteFortePluieDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionEtatCielTitre": "États du ciel (prévisions)",
  "@glossaireNotionEtatCielTitre": { "description": "Page glossaire EtatCielJour (ADR-0016)." },
  "glossaireNotionEtatCielDef": "Les prévisions résument chaque journée par un état du ciel, dérivé des codes météo internationaux (OMM). C'est lui qui choisit l'icône et le résumé en français de l'écran météo.",
  "@glossaireNotionEtatCielDef": { "description": "Définition." },
  "glossaireValCielEnsoleille": "Ensoleillé",
  "@glossaireValCielEnsoleille": { "description": "Valeur EtatCielJour." },
  "glossaireValCielNuageux": "Nuageux",
  "@glossaireValCielNuageux": { "description": "Valeur EtatCielJour." },
  "glossaireValCielCouvert": "Couvert",
  "@glossaireValCielCouvert": { "description": "Valeur EtatCielJour." },
  "glossaireValCielBrouillard": "Brouillard",
  "@glossaireValCielBrouillard": { "description": "Valeur EtatCielJour." },
  "glossaireValCielPluie": "Pluie",
  "@glossaireValCielPluie": { "description": "Valeur EtatCielJour." },
  "glossaireValCielNeige": "Neige",
  "@glossaireValCielNeige": { "description": "Valeur EtatCielJour." },
  "glossaireValCielOrage": "Orage",
  "@glossaireValCielOrage": { "description": "Valeur EtatCielJour." },
  "glossaireNotionExpositionTitre": "Exposition au soleil",
  "@glossaireNotionExpositionTitre": { "description": "Page glossaire NiveauSoleil." },
  "glossaireNotionExpositionDef": "Le nombre d'heures de soleil direct que reçoit une parcelle. Comptez-les un jour dégagé, puis comparez au besoin de chaque plante — l'app fait cette vérification pour ses recommandations.",
  "@glossaireNotionExpositionDef": { "description": "Définition." },
  "glossaireValExpositionPleinSoleilDesc": "6 heures de soleil direct ou plus.",
  "@glossaireValExpositionPleinSoleilDesc": { "description": "Descriptif NiveauSoleil.pleinSoleil." },
  "glossaireValExpositionMiOmbreDesc": "3 à 6 heures de soleil direct.",
  "@glossaireValExpositionMiOmbreDesc": { "description": "Descriptif NiveauSoleil.miOmbre." },
  "glossaireValExpositionOmbreDesc": "moins de 3 heures de soleil direct.",
  "@glossaireValExpositionOmbreDesc": { "description": "Descriptif NiveauSoleil.ombre." },

  "glossaireNotionCalculAssociationsTitre": "Comment l'app calcule les associations",
  "@glossaireNotionCalculAssociationsTitre": { "description": "Page générale du chapitre Associations (retour dev 2026-07-06)." },
  "glossaireNotionCalculAssociationsDef": "Le [[notion.compagnonnage|compagnonnage]] n'est pas une science exacte : les résultats dépendent du sol, du climat, de l'année et de mille facteurs propres à chaque potager. L'app ne promet donc jamais un effet — elle explique des raisons d'y croire, toujours vérifiables. Deux sources se complètent : les paires documentées par la communauté permaculture (reprises telles quelles des fiches) et les suggestions calculées par le moteur à partir des caractéristiques réelles des plantes (usages, hauteurs, racines, familles, besoins…).",
  "@glossaireNotionCalculAssociationsDef": { "description": "Définition (lien wiki) — pas une science exacte + les deux provenances." },
  "glossaireNotionCalculAssociationsAstuce": "Chaque mécanisme a sa page dans ce chapitre, avec sa provenance : calculé par le moteur ou documenté par la communauté.",
  "@glossaireNotionCalculAssociationsAstuce": { "description": "Astuce 💡." },
  "glossaireNotionCalculAssociationsConseil1": "Chaque suggestion liste ses critères avec les vraies valeurs des plantes (hauteurs, familles, besoins…) : dépliez « Pourquoi cette suggestion » pour juger vous-même.",
  "@glossaireNotionCalculAssociationsConseil1": { "description": "Conseil — critères ADR-0014." },
  "glossaireNotionCalculAssociationsConseil2": "Le [[notion.niveau-confiance|niveau de confiance]] dit la solidité du raisonnement ; la [[notion.ponderation-associations|pondération]] (profil expert) règle l'importance de chaque famille d'effets.",
  "@glossaireNotionCalculAssociationsConseil2": { "description": "Conseil (liens wiki)." },
  "glossaireNotionCalculAssociationsConseil3": "Testez, observez, notez : votre potager a toujours le dernier mot.",
  "@glossaireNotionCalculAssociationsConseil3": { "description": "Conseil." },
  "glossaireMecaTuteurStructurelDef": "Une plante haute et solide sert de support à une grimpante : le maïs porte le haricot (la célèbre milpa). Le moteur vérifie qu'une plante fait un support crédible et que la grimpante n'est pas trop lourde pour elle (voir la charge, page [[outil.tuteur|tuteur]]).",
  "@glossaireMecaTuteurStructurelDef": { "description": "Page mécanisme bénéfice (lien wiki)." },
  "glossaireMecaEtagementLumiereDef": "Une plante haute qui exige le plein soleil offre son ombre portée à une voisine nettement plus basse qui la préfère — ou au moins la tolère : deux étages de végétation sur la même surface.",
  "@glossaireMecaEtagementLumiereDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaRepulsionRavageurDef": "L'odeur d'une plante répulsive éloigne un ravageur précis qui vise sa voisine — l'œillet d'Inde contre les nématodes de la tomate. Le moteur croise les répulsions de l'une avec les ravageurs de la famille de l'autre.",
  "@glossaireMecaRepulsionRavageurDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaBrouillageOlfactifDef": "Deux aromatiques mêlées brouillent les repères des ravageurs, qui localisent leurs proies à l'odeur : le mélange protège les deux voisines.",
  "@glossaireMecaBrouillageOlfactifDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaAttractionPollinisateursDef": "Une plante mellifère attire abeilles et butineurs, dont profite la voisine qui a besoin d'insectes pour former ses fruits (plante entomophile) : courges, tomates, fraisiers…",
  "@glossaireMecaAttractionPollinisateursDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaAttractionAuxiliairesDef": "Une plante héberge ou nourrit les auxiliaires — prédateurs et parasitoïdes (coccinelles, syrphes, chrysopes…) — qui régulent les ravageurs de la voisine. C'est de la protection, pas de la pollinisation.",
  "@glossaireMecaAttractionAuxiliairesDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaPlantePiegeDef": "Une plante plus attirante que la culture détourne le ravageur sur elle : la capucine concentre les pucerons loin des fèves. On sacrifie la plante-piège, on sauve la récolte.",
  "@glossaireMecaPlantePiegeDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaFixationAzoteDef": "Les légumineuses (Fabacées) fixent l'azote de l'air grâce aux bactéries de leurs racines : une voisine gourmande en profite. Le duo classique : haricot et maïs.",
  "@glossaireMecaFixationAzoteDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaAmeublissementSolDef": "Une racine profonde ou pivotante décompacte le sol en profondeur, au bénéfice d'une voisine aux racines superficielles — chacune boit et mange à son étage (voir [[notion.enracinement|enracinement]]).",
  "@glossaireMecaAmeublissementSolDef": { "description": "Page mécanisme bénéfice (lien wiki)." },
  "glossaireMecaCouvreSolDef": "Une plante étalée couvre la terre au pied de sa voisine : humidité conservée, indésirables étouffés — un [[notion.paillage|paillage]] vivant (la courge de la milpa).",
  "@glossaireMecaCouvreSolDef": { "description": "Page mécanisme bénéfice (lien wiki)." },
  "glossaireMecaBriseVentDef": "Une plante haute et dense casse le vent au profit des voisines : moins de casse, moins de dessèchement, et des pollinisateurs qui travaillent tranquilles.",
  "@glossaireMecaBriseVentDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaSuccessionTemporelleDef": "Deux cultures se partagent la même place à des moments différents : un cycle court file avant qu'un cycle long n'occupe tout — le radis semé entre les rangs de carottes. Quand il connaît votre hémisphère et votre climat, le moteur vérifie les vraies périodes d'occupation du sol.",
  "@glossaireMecaSuccessionTemporelleDef": { "description": "Page mécanisme bénéfice." },
  "glossaireMecaMemeFamilleRavageursDef": "Deux plantes de la même [[notion.famille-botanique|famille botanique]] attirent les mêmes ravageurs et maladies : les concentrer, c'est dresser le buffet. C'est aussi le fondement de la [[notion.rotation-cultures|rotation]].",
  "@glossaireMecaMemeFamilleRavageursDef": { "description": "Page mécanisme conflit (liens wiki)." },
  "glossaireMecaCompetitionLumiereDef": "Deux plantes hautes qui exigent toutes deux le plein soleil finissent par se faire de l'ombre l'une à l'autre.",
  "@glossaireMecaCompetitionLumiereDef": { "description": "Page mécanisme conflit." },
  "glossaireMecaCompetitionAzoteDef": "Deux gourmandes en azote côte à côte épuisent la même réserve : croissance ralentie des deux côtés (voir [[notion.besoin-nutriments|besoin en nutriments]]).",
  "@glossaireMecaCompetitionAzoteDef": { "description": "Page mécanisme conflit (lien wiki)." },
  "glossaireMecaCompetitionEauDef": "Deux grosses buveuses côte à côte se disputent l'eau du sol dès que l'été serre la vis (voir [[notion.besoin-eau|besoins en eau]]).",
  "@glossaireMecaCompetitionEauDef": { "description": "Page mécanisme conflit (lien wiki)." },
  "glossaireMecaCompetitionEspaceDef": "Deux plantes très étalées se gênent : feuillages emmêlés, air qui ne circule plus, maladies favorisées.",
  "@glossaireMecaCompetitionEspaceDef": { "description": "Page mécanisme conflit." },
  "glossaireMecaPartageMaladiesDef": "Deux familles différentes mais hôtes d'une même maladie — le mildiou frappe tomates et pommes de terre : voisines, elles se contaminent l'une l'autre.",
  "@glossaireMecaPartageMaladiesDef": { "description": "Page mécanisme conflit." },
  "glossaireMecaAllelopathieDef": "Certaines plantes émettent des substances qui inhibent la croissance de leurs voisines : le noyer et sa juglone, le fenouil… Documentée par la communauté, l'allélopathie n'est pas déduite par le moteur — il n'existe pas de règle fiable à partir des caractéristiques des fiches.",
  "@glossaireMecaAllelopathieDef": { "description": "Page mécanisme conflit (curaté uniquement)." },
  "glossaireNotionFamillesEffetsTitre": "Familles d'effets",
  "@glossaireNotionFamillesEffetsTitre": { "description": "Page glossaire FamilleEffetAssociation + FamilleEffetConflit." },
  "glossaireNotionFamillesEffetsDef": "Les mécanismes se regroupent en grandes familles d'effets : c'est à cette échelle que se calcule le score d'une association — et que s'applique la [[notion.ponderation-associations|pondération]]. Bénéfices d'un côté, conflits de l'autre :",
  "@glossaireNotionFamillesEffetsDef": { "description": "Définition (lien wiki)." },
  "glossaireValFamGainDePlaceDesc": "tuteur naturel, étagement, succession dans le temps.",
  "@glossaireValFamGainDePlaceDesc": { "description": "Descriptif FamilleEffetAssociation.gainDePlace." },
  "glossaireValFamProtectionDesc": "répulsion, plante-piège, auxiliaires, brouillage olfactif.",
  "@glossaireValFamProtectionDesc": { "description": "Descriptif FamilleEffetAssociation.protectionRavageurs." },
  "glossaireValFamFertiliteDesc": "fixation d'azote, ameublissement du sol.",
  "@glossaireValFamFertiliteDesc": { "description": "Descriptif FamilleEffetAssociation.fertilite." },
  "glossaireValFamPollinisationDesc": "attraction des pollinisateurs.",
  "@glossaireValFamPollinisationDesc": { "description": "Descriptif FamilleEffetAssociation.pollinisation." },
  "glossaireValFamCouvertureDesc": "couvre-sol, brise-vent.",
  "@glossaireValFamCouvertureDesc": { "description": "Descriptif FamilleEffetAssociation.couvertureAbri." },
  "glossaireValFamConcurrenceDesc": "concurrence lumière, azote, eau ou espace.",
  "@glossaireValFamConcurrenceDesc": { "description": "Descriptif FamilleEffetConflit.concurrenceRessources." },
  "glossaireValFamSanitaireDesc": "même famille, maladies partagées.",
  "@glossaireValFamSanitaireDesc": { "description": "Descriptif FamilleEffetConflit.risqueSanitaire." },
  "glossaireValFamAllelopathieDesc": "substances qui inhibent les voisines.",
  "@glossaireValFamAllelopathieDesc": { "description": "Descriptif FamilleEffetConflit.allelopathie." },
  "glossaireNotionSensAssociationTitre": "Sens d'une association",
  "@glossaireNotionSensAssociationTitre": { "description": "Page glossaire SensAssociation (ADR-0012)." },
  "glossaireNotionSensAssociationDef": "Une association a un sens : la plante qui rend le service, celle qui en profite, ou les deux. Les flèches de la vue Associations le montrent, depuis la plante au centre.",
  "@glossaireNotionSensAssociationDef": { "description": "Définition." },
  "glossaireValSensDonneDesc": "la plante du centre aide sa voisine (→).",
  "@glossaireValSensDonneDesc": { "description": "Descriptif SensAssociation.donne." },
  "glossaireValSensRecoitDesc": "la voisine aide la plante du centre (←).",
  "@glossaireValSensRecoitDesc": { "description": "Descriptif SensAssociation.recoit." },
  "glossaireValSensMutuelDesc": "service — ou conflit — réciproque (↔).",
  "@glossaireValSensMutuelDesc": { "description": "Descriptif SensAssociation.mutuel." },
  "glossaireNotionNiveauConfianceTitre": "Niveau de confiance",
  "@glossaireNotionNiveauConfianceTitre": { "description": "Page glossaire NiveauConfiance." },
  "glossaireNotionNiveauConfianceDef": "Chaque suggestion calculée porte la solidité de son raisonnement. Les paires documentées, elles, ne sont pas des déductions : l'app les marque « hors moteur » — voir [[notion.calcul-associations|comment l'app calcule les associations]].",
  "@glossaireNotionNiveauConfianceDef": { "description": "Définition (lien wiki)." },
  "glossaireValConfianceFaibleDesc": "indice indirect — à tester en observant.",
  "@glossaireValConfianceFaibleDesc": { "description": "Descriptif NiveauConfiance.faible." },
  "glossaireValConfianceMoyenDesc": "les caractéristiques des deux plantes concordent.",
  "@glossaireValConfianceMoyenDesc": { "description": "Descriptif NiveauConfiance.moyen." },
  "glossaireValConfianceEleveDesc": "lien précis et vérifié entre les deux fiches.",
  "@glossaireValConfianceEleveDesc": { "description": "Descriptif NiveauConfiance.eleve." },
  "glossaireNotionPonderationTitre": "Pondération des associations",
  "@glossaireNotionPonderationTitre": { "description": "Page glossaire PoidsAssociation (ADR-0011, profil expert)." },
  "glossaireNotionPonderationDef": "Réglage du profil expert : donnez plus ou moins d'importance à chaque [[notion.familles-effets|famille d'effets]] dans le score des associations — ignorez ce qui ne vous parle pas, renforcez ce qui compte pour vous. Le tri des compagnons suit vos préférences.",
  "@glossaireNotionPonderationDef": { "description": "Définition (lien wiki)." },
  "glossaireValPoidsIgnoreDesc": "la famille d'effets ne compte plus dans le score.",
  "@glossaireValPoidsIgnoreDesc": { "description": "Descriptif PoidsAssociation.ignore." },
  "glossaireValPoidsFaibleDesc": "compte moitié moins.",
  "@glossaireValPoidsFaibleDesc": { "description": "Descriptif PoidsAssociation.faible." },
  "glossaireValPoidsNormalDesc": "le réglage par défaut.",
  "@glossaireValPoidsNormalDesc": { "description": "Descriptif PoidsAssociation.normal." },
  "glossaireValPoidsFortDesc": "compte moitié plus.",
  "@glossaireValPoidsFortDesc": { "description": "Descriptif PoidsAssociation.fort." },

  "glossaireNotionTypesTachesTitre": "Types de tâches",
  "@glossaireNotionTypesTachesTitre": { "description": "Page glossaire TypeTache." },
  "glossaireNotionTypesTachesDef": "Chaque tâche du Calendrier porte un geste du jardin : arroser, semer, tailler… Le type donne l'icône et la couleur de la tâche ; certaines sont créées automatiquement, comme l'[[notion.urgence-arrosage|arrosage urgent]].",
  "@glossaireNotionTypesTachesDef": { "description": "Définition (lien wiki)." },
  "glossaireNotionPrioriteTacheTitre": "Priorités des tâches",
  "@glossaireNotionPrioriteTacheTitre": { "description": "Page glossaire PrioriteTache." },
  "glossaireNotionPrioriteTacheDef": "Classez vos tâches par importance : l'urgent saute aux yeux dans le Calendrier. Les tâches d'arrosage créées par l'app arrivent avec leur priorité déjà réglée.",
  "@glossaireNotionPrioriteTacheDef": { "description": "Définition." },
  "glossaireValPrioriteBasse": "Basse",
  "@glossaireValPrioriteBasse": { "description": "Valeur PrioriteTache." },
  "glossaireValPrioriteNormale": "Normale",
  "@glossaireValPrioriteNormale": { "description": "Valeur PrioriteTache." },
  "glossaireValPrioriteHaute": "Haute",
  "@glossaireValPrioriteHaute": { "description": "Valeur PrioriteTache." },
  "glossaireValPrioriteUrgente": "Urgente",
  "@glossaireValPrioriteUrgente": { "description": "Valeur PrioriteTache." },
  "glossaireNotionRecurrenceTitre": "Récurrence des rappels",
  "@glossaireNotionRecurrenceTitre": { "description": "Page glossaire TypeRecurrence." },
  "glossaireNotionRecurrenceDef": "Un rappel peut se répéter : quotidien pour l'arrosage des semis, hebdomadaire pour la tournée d'observation… La récurrence recrée le rappel automatiquement.",
  "@glossaireNotionRecurrenceDef": { "description": "Définition." },
  "glossaireValRecurrencePonctuel": "Ponctuel",
  "@glossaireValRecurrencePonctuel": { "description": "Valeur TypeRecurrence." },
  "glossaireValRecurrencePonctuelDesc": "une seule fois.",
  "@glossaireValRecurrencePonctuelDesc": { "description": "Descriptif de la valeur." },
  "glossaireValRecurrenceQuotidien": "Quotidien",
  "@glossaireValRecurrenceQuotidien": { "description": "Valeur TypeRecurrence." },
  "glossaireValRecurrenceHebdomadaire": "Hebdomadaire",
  "@glossaireValRecurrenceHebdomadaire": { "description": "Valeur TypeRecurrence." },
  "glossaireValRecurrenceMensuel": "Mensuel",
  "@glossaireValRecurrenceMensuel": { "description": "Valeur TypeRecurrence." },
  "glossaireValRecurrencePersonnalise": "Personnalisé",
  "@glossaireValRecurrencePersonnalise": { "description": "Valeur TypeRecurrence." },
  "glossaireValRecurrencePersonnaliseDesc": "intervalle libre, en jours.",
  "@glossaireValRecurrencePersonnaliseDesc": { "description": "Descriptif de la valeur." },
  "glossaireNotionDestinationRecolteTitre": "Destinations d'une récolte",
  "@glossaireNotionDestinationRecolteTitre": { "description": "Page glossaire DestinationRecolte." },
  "glossaireNotionDestinationRecolteDef": "Quand vous notez une récolte, dites ce qu'elle devient : consommée, conservée, donnée, gardée en semences… De quoi mesurer ce que produit vraiment le potager.",
  "@glossaireNotionDestinationRecolteDef": { "description": "Définition." },
  "glossaireNotionQualiteRecolteTitre": "Qualité d'une récolte",
  "@glossaireNotionQualiteRecolteTitre": { "description": "Page glossaire QualiteRecolte." },
  "glossaireNotionQualiteRecolteDef": "Notez la qualité de vos récoltes pour comparer variétés, emplacements et saisons — la mémoire du potager, c'est vous qui la construisez.",
  "@glossaireNotionQualiteRecolteDef": { "description": "Définition." },
  "glossaireValQualiteRecolteExcellente": "Excellente",
  "@glossaireValQualiteRecolteExcellente": { "description": "Valeur QualiteRecolte." },
  "glossaireValQualiteRecolteBonne": "Bonne",
  "@glossaireValQualiteRecolteBonne": { "description": "Valeur QualiteRecolte." },
  "glossaireValQualiteRecolteMoyenne": "Moyenne",
  "@glossaireValQualiteRecolteMoyenne": { "description": "Valeur QualiteRecolte." },
  "glossaireValQualiteRecolteMediocre": "Médiocre",
  "@glossaireValQualiteRecolteMediocre": { "description": "Valeur QualiteRecolte." },
  "glossaireNotionUnitesTitre": "Unités de récolte",
  "@glossaireNotionUnitesTitre": { "description": "Page glossaire UniteQuantite." },
  "glossaireNotionUnitesDef": "Les récoltes se comptent en poids, en volume, à la pièce ou à la botte. L'app totalise vos récoltes au sein d'une même nature d'unité.",
  "@glossaireNotionUnitesDef": { "description": "Définition." },
  "glossaireValUniteGDesc": "grammes.",
  "@glossaireValUniteGDesc": { "description": "Descriptif UniteQuantite.g." },
  "glossaireValUniteKgDesc": "kilogrammes.",
  "@glossaireValUniteKgDesc": { "description": "Descriptif UniteQuantite.kg." },
  "glossaireValUnitePieceDesc": "à l'unité (salades, courges…).",
  "@glossaireValUnitePieceDesc": { "description": "Descriptif UniteQuantite.piece." },
  "glossaireValUniteBotteDesc": "en bottes (radis, carottes…).",
  "@glossaireValUniteBotteDesc": { "description": "Descriptif UniteQuantite.botte." },
  "glossaireValUniteLitreDesc": "litres.",
  "@glossaireValUniteLitreDesc": { "description": "Descriptif UniteQuantite.litre." },
  "glossaireValUniteMlDesc": "millilitres.",
  "@glossaireValUniteMlDesc": { "description": "Descriptif UniteQuantite.ml." },
  "glossaireNotionTypesObservationsTitre": "Types d'observations",
  "@glossaireNotionTypesObservationsTitre": { "description": "Page glossaire TypeObservation." },
  "glossaireNotionTypesObservationsDef": "Le journal du potager : notez maladies, ravageurs, carences, coups de météo, étapes de croissance… Chaque observation est typée, pour retrouver facilement l'historique d'une culture.",
  "@glossaireNotionTypesObservationsDef": { "description": "Définition." },
  "glossaireNotionGraviteObservationTitre": "Gravité d'une observation",
  "@glossaireNotionGraviteObservationTitre": { "description": "Page glossaire GraviteObservation." },
  "glossaireNotionGraviteObservationDef": "De la simple info au problème critique : la gravité aide à trier ce qui demande une action immédiate de ce qui se surveille.",
  "@glossaireNotionGraviteObservationDef": { "description": "Définition." },
  "glossaireValGraviteInfo": "Info",
  "@glossaireValGraviteInfo": { "description": "Valeur GraviteObservation." },
  "glossaireValGraviteFaible": "Faible",
  "@glossaireValGraviteFaible": { "description": "Valeur GraviteObservation." },
  "glossaireValGraviteModere": "Modérée",
  "@glossaireValGraviteModere": { "description": "Valeur GraviteObservation." },
  "glossaireValGraviteEleve": "Élevée",
