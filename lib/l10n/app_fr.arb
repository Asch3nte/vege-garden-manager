  "glossaireNotionTypesParcellesTitre": "Types de parcelles",
  "@glossaireNotionTypesParcellesTitre": { "description": "Page glossaire TypeParcelle." },
  "glossaireNotionTypesParcellesDef": "Pleine terre, bac surélevé, pot, serre, butte… Le type de parcelle décrit le contenant de vos cultures : profondeur de sol, drainage et arrosage n'y sont pas les mêmes.",
  "@glossaireNotionTypesParcellesDef": { "description": "Définition." },
  "glossaireNotionTypesParcellesConseil1": "En pot ou en jardinière, la terre sèche bien plus vite qu'en pleine terre : surveillez l'arrosage.",
  "@glossaireNotionTypesParcellesConseil1": { "description": "Conseil." },
  "glossaireNotionTypesEmplacementsTitre": "Types d'emplacements",
  "@glossaireNotionTypesEmplacementsTitre": { "description": "Page glossaire TypeEmplacement." },
  "glossaireNotionTypesEmplacementsDef": "Où vit votre potager : jardin, balcon, terrasse, toit, cour, intérieur… L'emplacement situe chaque potager de l'app.",
  "@glossaireNotionTypesEmplacementsDef": { "description": "Définition." },
  "glossaireNotionNiveauxExperienceTitre": "Niveaux d'expérience",
  "@glossaireNotionNiveauxExperienceTitre": { "description": "Page glossaire NiveauExperience (ADR-0009)." },
  "glossaireNotionNiveauxExperienceDef": "L'app s'adapte à votre expérience : l'interface reste simple au départ, puis dévoile des réglages plus pointus (qualités de sol, pondération des associations…) à mesure que vous montez. Rien d'essentiel n'est jamais bloqué — changez de niveau librement dans les réglages.",
  "@glossaireNotionNiveauxExperienceDef": { "description": "Définition." },
  "glossaireNotionPermacultureTitre": "Permaculture",
  "@glossaireNotionPermacultureTitre": { "description": "Notion transverse (annexe A)." },
  "glossaireNotionPermacultureDef": "Une démarche de conception qui imite les écosystèmes : sol couvert et vivant, diversité, associations, eau économisée. Le potager y devient un système où chaque élément rend plusieurs services — la philosophie dont cette app s'inspire, du [[notion.compagnonnage|compagnonnage]] au [[notion.no-dig|sans labour]].",
  "@glossaireNotionPermacultureDef": { "description": "Définition (liens wiki)." },
  "glossaireNotionPermacultureConseil1": "Commencez petit et observez avant d'aménager : le meilleur plan vient du terrain.",
