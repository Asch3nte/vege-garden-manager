  "glossaireValLegumeRacineDesc": "carotte, radis, betterave… on récolte la racine.",
  "@glossaireValLegumeRacineDesc": { "description": "Descriptif de la valeur." },
  "glossaireValLegumeBulbe": "Légume-bulbe",
  "@glossaireValLegumeBulbe": { "description": "Valeur SousTypeLegume." },
  "glossaireValLegumeBulbeDesc": "oignon, ail, échalote… on récolte le bulbe.",
  "@glossaireValLegumeBulbeDesc": { "description": "Descriptif de la valeur." },
  "glossaireValLegumeTige": "Légume-tige",
